{
  "name": "acrebrief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first public-record property intelligence powered by Solari.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-build-trace.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/record-demo.mjs",
    "release:check-public": "node scripts/check-public-release.mjs",
    "source-policy:generate": "node scripts/generate-source-policy.mjs",
    "source-policy:check": "node scripts/generate-source-policy.mjs --check",
    "verify": "npm run source-policy:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@solarisdk/browser": "0.1.2",
    "@solarisdk/sdk": "0.1.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
