# Solari: required for live Browser + Sandbox investigations.
SOLARI_API_KEY=slr_live_replace_me
ACREBRIEF_LIVE_ACCESS_TOKEN=replace_with_a_long_random_demo_token
# Opt-in only for the competition's one-property live demo. Keep false elsewhere.
ACREBRIEF_PUBLIC_LIVE_DEMO=false
# Default deny. Add reviewed source IDs only after terms/rate-limit approval.
ACREBRIEF_APPROVED_SOURCE_IDS=
# Required before enabling scheduled snapshot diffs or database-backed intake.
DATABASE_URL=postgresql://replace-with-pooled-server-side-connection
DATABASE_URL_UNPOOLED=postgresql://replace-with-direct-server-side-connection
CRON_SECRET=replace-with-at-least-16-random-characters
PILOT_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
ACREBRIEF_RELEASE_SHA=local

# Public deployment metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=verified-sample
